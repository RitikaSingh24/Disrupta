# ============================================================
# IROP Passenger Rebooking Copilot — Backend Environment
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Database (Supabase connection pooler — use port 6543) ──
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<supabase-pooler-host>:6543/postgres

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=<random-32+-char-string-change-this>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ── OpenAI (Phase 8 — leave blank until you reach that phase) ─
OPENAI_API_KEY=sk-...

# ── Feature flags ──────────────────────────────────────────
# Set to false to run the rule engine only (safe for demo fallback)
USE_AI_REASONING=false

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://<your-vercel-domain>.vercel.app

# ── Passenger portal ───────────────────────────────────────
PORTAL_TOKEN_EXPIRY_HOURS=72
